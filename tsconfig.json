{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["node", "vite/client"]
    },
    "include": ["local/js/dsefremov.shopclassic/src/**/*.ts", "local/js/dsefremov.shopclassic/src/**/*.tsx", "e2e/**/*.ts", "playwright.config.ts", "vite.config.ts"]
}
