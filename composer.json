{
    "name": "dsefremov/bitrix-shop-classic",
    "description": "Учебный интернет-магазин на штатных модулях 1С-Битрикс (iblock, catalog, sale): модуль dsefremov.shopclassic, шаблоны компонентов, шаблон сайта",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/mime": "^7.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Dsefremov\\ShopClassic\\": "local/modules/dsefremov.shopclassic/lib/",
            "Dsefremov\\ShopClassic\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit"
    }
}
