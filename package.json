{
    "name": "bitrix-shop-classic",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "vite build",
        "types:check": "tsc --noEmit",
        "lint:check": "eslint .",
        "format": "prettier --write local/js/dsefremov.shopclassic/src e2e playwright.config.ts vite.config.ts",
        "format:check": "prettier --check local/js/dsefremov.shopclassic/src e2e playwright.config.ts vite.config.ts",
        "test:e2e": "playwright test --project=e2e",
        "screenshots": "playwright test --project=screenshots"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@playwright/test": "1.65.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.1.11",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.0"
    }
}
